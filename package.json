{
  "name": "sectools-chrome-extension",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "doctor": "npm run lint && npm run typecheck && npm run test && npm run build",
    "zip": "cd dist && zip -r ../sectools-v$npm_package_version.zip . -x '*.DS_Store'",
    "release": "npm run build && npm run zip",
    "prepare": "simple-git-hooks || true"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "simple-git-hooks": {
    "pre-push": "npm run doctor"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.270",
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.38",
    "simple-git-hooks": "^2.11.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
